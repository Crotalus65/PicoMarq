{
  "name": "picomarq",
  "productName": "PicoMarQ",
  "private": true,
  "version": "1.3.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs && node --experimental-strip-types --test tests/*.test.mts",
    "package:windows": "npm run build && node scripts/package-windows.cjs",
    "test:desktop": "node tests/desktop-smoke.cjs",
    "build:icon": "node scripts/build-icon.cjs",
    "test:equivalence": "vite build --config tests/markdown-equivalence/vite.config.ts && node tests/markdown-equivalence/run.cjs",
    "test:typography": "node tests/typography-smoke.cjs",
    "test:startup": "node tests/startup-smoke.cjs",
    "test:close-restore": "node tests/close-restore-smoke.cjs",
    "test:close-window": "node tests/close-command-smoke.cjs",
    "test:settings": "node tests/settings-smoke.cjs",
    "test:spelling": "node tests/spelling-smoke.cjs",
    "test:word-count": "node tests/word-count-smoke.cjs",
    "test:ignore": "node tests/ignore-smoke.cjs",
    "test:dictionary": "node tests/dictionary-smoke.cjs",
    "test:find": "node tests/find-smoke.cjs",
    "test:paragraph": "node tests/paragraph-smoke.cjs",
    "test:undo": "node tests/undo-smoke.cjs",
    "test:pictures": "node tests/pictures-smoke.cjs"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tiptap/core": "^3.19.0",
    "@tiptap/extension-code-block-lowlight": "^3.20.0",
    "@tiptap/extension-image": "^3.18.0",
    "@tiptap/extension-link": "^3.18.0",
    "@tiptap/extension-list": "^3.19.0",
    "@tiptap/extension-mathematics": "^3.18.0",
    "@tiptap/extension-placeholder": "^3.18.0",
    "@tiptap/extension-table": "^3.19.0",
    "@tiptap/extension-table-cell": "^3.19.0",
    "@tiptap/extension-table-header": "^3.19.0",
    "@tiptap/extension-table-row": "^3.19.0",
    "@tiptap/extension-task-item": "^3.18.0",
    "@tiptap/extension-task-list": "^3.18.0",
    "@tiptap/extension-underline": "^3.20.0",
    "@tiptap/markdown": "^3.18.0",
    "@tiptap/pm": "^3.18.0",
    "@tiptap/react": "^3.18.0",
    "@tiptap/starter-kit": "^3.18.0",
    "beautiful-mermaid": "^1.1.3",
    "clsx": "^2.1.1",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.33",
    "lowlight": "^3.3.0",
    "react": "^19.1.0",
    "react-colorful": "^5.6.1",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tippy.js": "^6.3.7"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "44.11.5",
    "pe-library": "2.0.1",
    "playwright": "1.62.1",
    "resedit": "3.1.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  },
  "description": "PicoMarQ, a personal Markdown editor adapted from Scratch",
  "main": "desktop/main.cjs"
}
