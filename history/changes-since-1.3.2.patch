+module.exports = [
+  ['file://server/share/x.png', 'server'],
+  ['file://SERVER/share/x.png', 'server'],
+  ['file://server.example.com/share/x.png', 'server.example.com'],
+  ['file://192.168.1.20/share/x.png', '192.168.1.20'],
