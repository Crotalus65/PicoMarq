+  const host = shareHostOf(/^[\\/]{2}/.test(address) ? `file:${address.replace(/\\/g, '/')}` : address);
+  if (host === null) return address;
+  return documentPath !== null && shareHostOf(fileUrl(documentPath)) === host ? address : '';
