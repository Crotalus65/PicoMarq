@@ -0,0 +1,227 @@
+// "Ignore All" in the right-click spelling menu, in the real Electron app.
+// Needs a graphical session or Xvfb, and a US English dictionary (see
+// tests/spelling-harness.cjs). Without one it is skipped.
+//
+// What it guards: every occurrence of an ignored word loses its underline and
+// later ones never get one; the other misspellings keep theirs, although
+// wrapping the first letter of the ignored words makes Chromium drop
+// underlines near them (the last paragraph is far from the caret, where
+// Chromium does not look again by itself); Chromium's background checks go on
+// wherever the caret is in the document, and a recheck waits while the caret
+// is in the Find panel; the list lasts through Undo, a paste, the Markdown
+// source view, Replace All and Revert, and is gone when the document is
+// closed. The Markdown is never changed and nothing is added to the
+// dictionary.
+// Usage: node tests/ignore-smoke.cjs
+const assert = require('node:assert/strict');
+const { startSpellingApp, active, pause } = require('./spelling-harness.cjs');
+let app;
+
+const filler = Array.from({ length: 30 }, (_, i) => `Sentence number ${i + 1} of this long paragraph says nothing of interest about the weather.`).join(' ');
+const LONG = `The long paragraph begins with a seperate mistake. ${filler} It ends here`;
+const DOCUMENT = `# Ignore All Check
+
+Qarth is a walled city. The peeple of Qarth recieve few visitors, and Qarth's gates are tall.
+
+In bold, **Qarth** counts too. Not the same word: Qarths. One definately wrong word.
+
+${LONG}
+
+The last paragraph has an occured error, a long way from Qarth.
+`;
+
+async function main() {
+  app = await startSpellingApp({ name: 'ignore-smoke', display: process.env.SCRATCH_DISPLAY_NUMBER || '127' });
+  if (!app) { console.log('SKIP: no US English dictionary (set PICOMARQ_TEST_BDIC or install hunspell-en-us)'); return; }
+  const { expectMarks, watch, rightClick, choose, command, markdown, selectionState } = app;
+  const file = await app.write('Ignore All Check.md', DOCUMENT);
+  await app.open(file);
+  const page = () => app.page;
+
+  // Put the caret in the text block that contains `block`: at its end, or at
+  // an offset into the first occurrence of `word` in it.
+  const caret = (block, word, offset = 0) => page().evaluate(({ block, word, offset, active }) => {
+    const editor = document.querySelector(`${active} .tiptap`).editor;
+    let target = null;
+    editor.state.doc.descendants((node, pos) => {
+      if (target === null && node.isTextblock && node.textContent.includes(block)) target = word ? pos + 1 + node.textContent.indexOf(word) + offset : pos + node.nodeSize - 1;
+      return target === null;
+    });
+    if (target === null) throw new Error(`No block with "${block}"`);
+    editor.chain().focus().setTextSelection(target).run();
+    return target;
+  }, { block, word, offset, active });
+  const head = () => page().evaluate(active => document.querySelector(`${active} .tiptap`).editor.state.selection.head, active);
+  // The editor learns of a caret move a moment after the key (selectionchange).
+  const headBecomes = async (expected, what) => {
+    const start = Date.now();
+    let actual;
+    while ((actual = await head()) !== expected) {
+      if (Date.now() - start > 1000) assert.fail(`${what}: caret at ${actual}, expected ${expected}; ${JSON.stringify(await selectionState())}`);
+      await pause(20);
+    }
+  };
+
+  const others = { peeple: 'red', recieve: 'red', definately: 'red', seperate: 'red', occured: 'red' };
+  await expectMarks({ Qarth: 'red', "Qarth's": 'red', Qarths: 'red', ...others }, 'opened file', 10000);
+  const original = await markdown();
+
+  // 1. The menu, and Ignore All.
+  const menu = await rightClick('Qarth', 1);
+  const separator = menu.indexOf('-');
+  assert.deepEqual(menu.slice(separator - 2, separator), ['Ignore All', 'Add to Dictionary'], `Spelling items: ${menu.join(', ')}`);
+  assert(separator >= 3, `Expected suggestions or "No spelling suggestions" above Ignore All: ${menu.join(', ')}`);
+  await choose('Ignore All');
+  const blink = await expectMarks({ Qarth: 'ignored', "Qarth's": 'ignored', Qarths: 'red', ...others }, 'Ignore All');
+  assert.equal(await markdown(), original, 'Ignore All must not change the Markdown');
+  assert.equal(await page().locator('footer').innerText().then(text => text.includes('Unsaved')), false, 'Ignore All must not mark the document as changed');
+  assert.deepEqual(await app.dictionaryWords(), [], 'Ignore All must not add to the dictionary');
+  assert.equal(await page().locator(`${active} .tiptap [data-ignored-spelling]`).evaluateAll(wrappers => wrappers.every(wrapper => wrapper.textContent.length === 1 && wrapper.getAttribute('spellcheck') === 'false')), true, 'Only the first letter of an ignored word is wrapped');
+  console.log(`PASS: Ignore All sits above Add to Dictionary; every "Qarth" (plain, bold, possessive) loses its underline, "Qarths" and the other misspellings keep theirs (back after ${blink} ms); Markdown and dictionary untouched`);
+
+  // 2. An ignored word is no longer a misspelling in the menu, and a
+  // double-click still selects all of it.
+  const ignoredMenu = await rightClick('Qarth', 0);
+  assert.equal(ignoredMenu.includes('Ignore All') || ignoredMenu.includes('Add to Dictionary'), false, `Menu on an ignored word: ${ignoredMenu.join(', ')}`);
+  assert.equal(ignoredMenu[0], 'Bold');
+  await page().keyboard.press('Escape');
+  const point = await app.pointOf('Qarth', 1);
+  await page().mouse.dblclick(point.x, point.y);
+  await pause(200);
+  assert.equal(await page().evaluate(() => document.getSelection().toString()), 'Qarth', 'A double-click should select the whole ignored word');
+  console.log('PASS: the right-click menu on an ignored word has no spelling items; a double-click selects the whole word');
+
+  // 3. Chromium stops its background checks while the caret is inside an
+  // element with spell checking off. The caret is "inside" a wrapper right
+  // after the first letter of an ignored word, and before that letter at the
+  // start of a paragraph. The checks must go on there, and the keys must
+  // work as usual.
+  for (const [place, offset] of [['right after the first letter of an ignored word', 1], ['before an ignored word at the start of a paragraph', 0]]) {
+    const at = await caret('walled city', 'Qarth', offset);
+    await pause(300);
+    const selection = await selectionState();
+    assert(!selection.focus.includes('in wrapper'), `Caret ${place}: the selection should be named from outside the wrapper: ${JSON.stringify(selection)}`);
+    const seen = await watch(['occured', 'definately'], () => command('recheck-spelling'), { duration: 3000 });
+    assert(seen.some(sample => sample.occured?.[0] === 'plain'), `Caret ${place}: the recheck did not start`);
+    assert(seen.slice(-5).every(sample => sample.occured?.[0] === 'red' && sample.definately?.[0] === 'red'), `Caret ${place}: the underlines did not come back: ${JSON.stringify(seen.slice(-3))}; ${JSON.stringify(await selectionState())}`);
+    assert.equal(await head(), at, `Caret ${place}: the caret moved`);
+  }
+  const wordStart = await caret('walled city', 'Qarth', 0);
+  for (let step = 1; step <= 5; step++) { await page().keyboard.press('ArrowRight'); await headBecomes(wordStart + step, 'Right Arrow through an ignored word'); }
+  for (let step = 4; step >= 0; step--) { await page().keyboard.press('ArrowLeft'); await headBecomes(wordStart + step, 'Left Arrow through an ignored word'); }
+  // Without waiting between the keys, as with a held-down arrow key.
+  for (let step = 1; step <= 5; step++) await page().keyboard.press('ArrowRight');
+  await headBecomes(wordStart + 5, 'Five quick Right Arrows');
+  for (let step = 1; step <= 5; step++) await page().keyboard.press('ArrowLeft');
+  await headBecomes(wordStart, 'Five quick Left Arrows');
+  await page().keyboard.press('ArrowRight');
+  await page().keyboard.type('x', { delay: 35 });
+  await expectMarks({ Qxarth: 'red', peeple: 'red', recieve: 'red' }, 'a letter typed right after the first letter of an ignored word');
+  await page().keyboard.press('Backspace');
+  await expectMarks({ Qarth: 'ignored', "Qarth's": 'ignored', peeple: 'red', recieve: 'red', ...others }, 'the letter removed again');
+  await page().keyboard.press('Home');
+  await page().keyboard.type('So ', { delay: 35 });
+  for (let i = 0; i < 3; i++) await page().keyboard.press('Backspace');
+  await expectMarks({ Qarth: 'ignored', peeple: 'red', recieve: 'red', ...others }, 'typing before an ignored word at the start of a paragraph');
+  console.log('PASS: with the caret at either edge of a wrapper the background checks go on (a full recheck completes), the arrow keys step through the word, and typing there works');
+
+  // 4. Typing the word again in a short paragraph: no underline for it, and
+  // nothing else blinks (Chromium rechecks the paragraph by itself). A typed
+  // possessive, with the curly apostrophe of Smart Typography, counts too.
+  await caret('One definately wrong word');
+  let samples = await watch(['definately', 'occured', 'seperate'], () => page().keyboard.type(" Then Qarth fell and Qarth's peeple left", { delay: 35 }));
+  assert(samples.every(s => s.occured?.every(state => state === 'red') && s.seperate?.every(state => state === 'red')), 'Underlines in other paragraphs blinked while an ignored word was typed in a short paragraph');
+  assert(samples.slice(-10).every(s => s.definately?.every(state => state === 'red')), 'The misspelling in the same short paragraph lost its underline');
+  await expectMarks({ Qarth: 'ignored', 'Qarth’s': 'ignored', peeple: 'red', definately: 'red' }, 'typed occurrence');
+  console.log('PASS: an ignored word typed again in a short paragraph gets no underline (nor does its possessive), and no other underline is lost or blinks');
+
+  // 5. Typing right after an ignored word, mid-paragraph.
+  await caret('walled city', 'The peeple of Qarth', 'The peeple of Qarth'.length);
+  samples = await watch(['recieve', 'occured'], () => page().keyboard.type(' still', { delay: 35 }));
+  assert(samples.every(s => s.occured?.every(state => state === 'red')), 'Underlines in other paragraphs blinked while typing after an ignored word');
+  assert(samples.every(s => s.recieve?.every(state => state === 'red')), 'The underline later in the paragraph was lost while typing after an ignored word');
+  await expectMarks({ Qarth: 'ignored', peeple: 'red', recieve: 'red' }, 'typing after an ignored word');
+  console.log('PASS: typing right after an ignored word keeps the underlines later in the paragraph');
+
+  // 6. The same in a long paragraph, where Chromium only rechecks near the
+  // caret: the editor asks for a full recheck once typing has paused.
+  await caret('It ends here');
+  await page().keyboard.type(' in Qarth', { delay: 35 });
+  const healed = await expectMarks({ Qarth: 'ignored', seperate: 'red', ...others }, 'long paragraph');
+  console.log(`PASS: in a 2,600-character paragraph the far misspelling has its underline again ${healed} ms after an ignored word was typed`);
+
+  // 7. An ignored word that is edited is a different word; Undo brings the ignored one back.
+  await caret('The last paragraph');
+  await page().keyboard.type(' Qarth', { delay: 35 });
+  await page().keyboard.press('Backspace');
+  await page().keyboard.type(' ', { delay: 35 });
+  await expectMarks({ Qart: 'red', occured: 'red' }, 'ignored word edited into another word');
+  await page().keyboard.press('Backspace');
+  await page().keyboard.type('h', { delay: 35 });
+  await expectMarks({ Qarth: 'ignored', occured: 'red' }, 'word completed again');
+  await page().keyboard.press('Control+z');
+  await page().keyboard.press('Control+z');
+  await page().keyboard.press('Control+y');
+  await expectMarks({ Qarth: 'ignored', ...others }, 'Undo and Redo');
+  console.log('PASS: an edited occurrence is checked again as a new word; Undo and Redo keep the other underlines');
+
+  // 8. A paste, the Markdown source view, and a second ignored word.
+  await app.electron.evaluate(({ clipboard }) => clipboard.writeText('Pasted: Qarth is far, and tommorow is another day.'));
+  await page().keyboard.press('Control+End');
+  await page().keyboard.press('Enter');
+  await page().keyboard.press('Control+V');
+  await expectMarks({ Qarth: 'ignored', tommorow: 'red', ...others }, 'paste');
+  await command('source');
+  const textarea = page().locator(`${active} textarea`);
+  await textarea.waitFor();
+  await textarea.evaluate(t => { t.focus(); t.setSelectionRange(t.value.length, t.value.length); });
+  await page().keyboard.type('\n\nFrom the source view: Qarth and an embarass error.');
+  await command('source');
+  await page().waitForSelector(`${active} .tiptap`, { state: 'visible' });
+  await expectMarks({ Qarth: 'ignored', embarass: 'red', tommorow: 'red', ...others }, 'back from the Markdown source view');
+  await rightClick('peeple', 0);
+  await choose('Ignore All');
+  await expectMarks({ Qarth: 'ignored', peeple: 'ignored', recieve: 'red', definately: 'red', seperate: 'red', occured: 'red' }, 'second ignored word');
+  console.log('PASS: the list holds through a paste and the Markdown source view, and takes a second word');
+
+  // 9. A change made from the Find panel, next to an ignored word, also needs
+  // a full recheck. It must wait until the caret is back in the document:
+  // Chromium checks only the text that holds the caret, so with the caret in
+  // the Replace box it would clear every underline and bring none back.
+  await command('replace');
+  const replaceBox = page().getByPlaceholder('Replace with...');
+  await page().getByPlaceholder('Find in note...').fill('Qarth is far');
+  await replaceBox.fill('Qarth was far');
+  const elsewhere = ['recieve', 'definately', 'seperate', 'occured'];
+  samples = await watch(elsewhere, () => replaceBox.press('Control+Enter'), { duration: 3000 });
+  assert((await markdown()).includes('Qarth was far'), 'Replace All should have changed the text');
+  assert(samples.every(s => elsewhere.every(word => s[word]?.every(state => state === 'red'))), `Underlines disappeared while the caret was in the Replace box: ${JSON.stringify(samples.find(s => !elsewhere.every(word => s[word]?.every(state => state === 'red'))))}`);
+  await page().keyboard.press('Escape');
+  await expectMarks({ Qarth: 'ignored', peeple: 'ignored', tommorow: 'red', embarass: 'red', recieve: 'red', definately: 'red', seperate: 'red', occured: 'red' }, 'back in the document after Replace All');
+  console.log('PASS: after Replace All next to an ignored word the underlines stay while the caret is in the Find panel, and the document is rechecked when the caret returns');
+
+  // 10. Revert to Saved reloads the file in the same window: the list stays.
+  await app.answer(0);
+  await command('revert');
+  await page().waitForFunction(active => !document.querySelector(`${active} .tiptap`)?.textContent.includes('tommorow'), active, { timeout: 10000 });
+  await expectMarks({ Qarth: 'ignored', "Qarth's": 'ignored', peeple: 'ignored', Qarths: 'red', recieve: 'red', definately: 'red', seperate: 'red', occured: 'red' }, 'after Revert to Saved', 10000);
+  assert.equal(await markdown(), original, 'Revert should restore the saved Markdown');
+  console.log('PASS: Revert to Saved keeps the ignored words of the open document');
+
+  // 11. Closing the document forgets them.
+  await app.win.evaluate(window => window.close());
+  await pause(800);
+  await app.open(file);
+  await expectMarks({ Qarth: 'red', "Qarth's": 'red', Qarths: 'red', ...others }, 'reopened document', 10000);
+  console.log('PASS: after the document is closed and opened again, the words are underlined again');
+  assert.equal(app.errors.length, 0, app.errors.join('\n'));
+}
+
+const watchdog = setTimeout(() => { console.error('Ignore All checks timed out'); process.exit(1); }, 240000);
+main().then(() => console.log('IGNORE ALL CHECKS DONE')).catch(error => {
+  console.error(error);
+  process.exitCode = 1;
+}).finally(async () => {
+  await app?.stop();
+  clearTimeout(watchdog);
+});
diff --git a/tests/ignored-spelling.test.mts b/tests/ignored-spelling.test.mts
new file mode 100644
index 0000000..a6ab52d
--- /dev/null
+++ b/tests/ignored-spelling.test.mts
@@ -0,0 +1,74 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { findIgnoredRanges, forgetIgnoredWords, ignoredForms, ignoredWords, ignoreWord, normalizeIgnoredWord, NO_IGNORED_FORMS } from '../src/lib/ignored-spelling.ts';
+
+// The words found in a text, for a list of ignored words.
+const found = (text: string, ...ignored: string[]) => findIgnoredRanges(text, ignoredForms(new Set(ignored.map(normalizeIgnoredWord)))).map(([from, to]) => text.slice(from, to));
+
+test('an ignored word is found as a whole word, wherever punctuation allows', () => {
+  assert.deepEqual(found('Qarth is far. In Qarth, "Qarth" (Qarth) Qarth-born; Qarth.', 'Qarth'), ['Qarth', 'Qarth', 'Qarth', 'Qarth', 'Qarth', 'Qarth']);
+  assert.deepEqual(findIgnoredRanges('The city of Qarth.', ignoredForms(new Set(['Qarth']))), [[12, 17]]);
+  // Not inside a longer word, with letters, digits or an apostrophe-joined part around it.
+  assert.deepEqual(found("Qarths aQarth Qarth2 2Qarth O'Qarth Qarth'ian", 'Qarth'), []);
+  assert.deepEqual(found('', 'Qarth'), []);
+  assert.deepEqual(found('Qarth', ), []);
+});
+
+test('a possessive of an ignored word is covered, with a straight or a curly apostrophe', () => {
+  assert.deepEqual(found("Qarth's gates and Qarth’s walls, QARTH'S too", 'Qarth'), ["Qarth's", 'Qarth’s', "QARTH'S"]);
+  // Ignoring the possessive ignores the word itself: it is kept as its base.
+  assert.equal(normalizeIgnoredWord('Qarth’s'), 'Qarth');
+  assert.equal(normalizeIgnoredWord("Qarth's"), 'Qarth');
+  assert.equal(normalizeIgnoredWord("  don't "), "don't");
+  assert.equal(normalizeIgnoredWord("'s"), "'s");
+  assert.deepEqual(found("Qarth and Qarth's", "Qarth's"), ['Qarth', "Qarth's"]);
+  // An apostrophe inside the word is part of it.
+  assert.deepEqual(found("O'Qarth said so; O’Qarth too, but not Qarth", "O'Qarth"), ["O'Qarth", 'O’Qarth']);
+});
+
+test('capitals follow the dictionary rule: a lower-case word also matches at the start of a sentence and in capitals', () => {
+  assert.deepEqual(found('gonna Gonna GONNA gOnna', 'gonna'), ['gonna', 'Gonna', 'GONNA']);
+  // A word with a capital matches as written, and in capitals.
+  assert.deepEqual(found('Qarth qarth QARTH QArth', 'Qarth'), ['Qarth', 'QARTH']);
+  assert.deepEqual(found('McQarth mcqarth MCQARTH Mcqarth', 'McQarth'), ['McQarth', 'MCQARTH']);
+});
+
+test('letters of any alphabet, combining marks and digits belong to a word', () => {
+  assert.deepEqual(found('Zoë, Zoe and Zoës; Zoë with a combining mark', 'Zoë'), ['Zoë']);
+  assert.deepEqual(found('Zoë and Zoe', 'Zoë'), ['Zoë']);
+  assert.deepEqual(found('Москва и Москварека', 'Москва'), ['Москва']);
+  assert.deepEqual(found('R2D2 and R2D22', 'R2D2'), ['R2D2']);
+  // The placeholder that stands for an image or a line break ends a word.
+  assert.deepEqual(found('Qarth￼Qarth', 'Qarth'), ['Qarth', 'Qarth']);
+});
+
+test('a spelling with other characters in it is searched for as it is', () => {
+  assert.deepEqual(found('See example.con and example.cons, not anexample.con', 'example.con'), ['example.con']);
+  assert.deepEqual(found('well-nigh, well-nighs, swell-nigh', 'well-nigh'), ['well-nigh']);
+  // Together with ordinary words, in order, and without overlaps.
+  assert.deepEqual(found('Qarth has well-nigh no gates. Qarth!', 'well-nigh', 'Qarth'), ['Qarth', 'well-nigh', 'Qarth']);
+  assert.deepEqual(findIgnoredRanges('a-b a-b', ignoredForms(new Set(['a-b']))), [[0, 3], [4, 7]]);
+});
+
+test('the list belongs to one document and is forgotten when the document is closed', () => {
+  assert.equal(ignoredWords('first').size, 0);
+  assert.equal(ignoredWords(null).size, 0);
+  const one = ignoreWord('first', 'Qarth’s');
+  assert.deepEqual([...one], ['Qarth']);
+  assert.equal(ignoredWords('first'), one, 'the same set until the list changes');
+  assert.equal(ignoreWord('first', 'Qarth'), one, 'a word that is already ignored changes nothing');
+  assert.equal(ignoreWord('first', '   '), one);
+  assert.equal(ignoreWord('first', 'x'.repeat(101)), one);
+  const two = ignoreWord('first', 'peeple');
+  assert.notEqual(two, one, 'a new set when the list grows, so that the editor notices');
+  assert.deepEqual([...two], ['Qarth', 'peeple']);
+  assert.deepEqual([...one], ['Qarth'], 'the earlier set is left as it was');
+  ignoreWord('second', 'Zorblat');
+  assert.deepEqual([...ignoredWords('second')], ['Zorblat']);
+  forgetIgnoredWords(['second']);
+  assert.equal(ignoredWords('first').size, 0);
+  assert.deepEqual([...ignoredWords('second')], ['Zorblat']);
+  forgetIgnoredWords([]);
+  assert.equal(ignoredWords('second').size, 0);
+  assert.equal(ignoredForms(new Set()), NO_IGNORED_FORMS);
+});
diff --git a/tests/spelling-harness.cjs b/tests/spelling-harness.cjs
new file mode 100644
index 0000000..938b8b6
--- /dev/null
+++ b/tests/spelling-harness.cjs
@@ -0,0 +1,226 @@
+// Shared by tests/ignore-smoke.cjs and tests/dictionary-smoke.cjs: starts the
+// real Electron app with a US English dictionary and reads the red spelling
+// underlines off the screen. Needs a graphical session or Xvfb, and a
+// dictionary: PICOMARQ_TEST_BDIC=/path/en-US-10-1.bdic, or the system's
+// Hunspell en_US files, which are converted with scripts/hunspell-to-bdic.py.
+const assert = require('node:assert/strict');
+const fs = require('node:fs/promises');
+const fsSync = require('node:fs');
+const path = require('node:path');
+const { spawn, execFileSync } = require('node:child_process');
+const { _electron } = require('playwright');
+
+const root = path.resolve(__dirname, '..');
+const active = '[data-document-id][aria-hidden="false"]';
+const pause = ms => new Promise(resolve => setTimeout(resolve, ms));
+
+function dictionary(work) {
+  if (process.env.PICOMARQ_TEST_BDIC) return process.env.PICOMARQ_TEST_BDIC;
+  if (!fsSync.existsSync('/usr/share/hunspell/en_US.dic')) return null;
+  const out = path.join(work, 'en-US-10-1.bdic');
+  execFileSync('python3', ['-I', path.join(root, 'scripts/hunspell-to-bdic.py'), '/usr/share/hunspell/en_US', out], { stdio: 'ignore' });
+  return out;
+}
+
+/**
+ * Start the app. Returns null when there is no dictionary to test with.
+ * `app.page` and `app.win` are the document window that was opened last (or
+ * chosen with app.use); every helper works on that window.
+ */
+async function startSpellingApp({ name, display }) {
+  const work = path.join(__dirname, 'tmp', name);
+  await fs.rm(work, { recursive: true, force: true });
+  await fs.mkdir(path.join(work, 'data', 'Dictionaries'), { recursive: true });
+  const bdic = dictionary(work);
+  if (!bdic) return null;
+  // Electron reads an existing dictionary file instead of downloading one.
+  await fs.copyFile(bdic, path.join(work, 'data', 'Dictionaries', 'en-US-10-1.bdic'));
+  let virtualDisplay;
+  if (process.platform === 'linux' && !process.env.DISPLAY) {
+    const binary = process.env.SCRATCH_XVFB || 'Xvfb';
+    virtualDisplay = spawn(binary, [':' + display, '-screen', '0', '1440x1800x24', '-listen', 'tcp', '-nolisten', 'unix', '-nolisten', 'local', '-ac'], { env: process.env, stdio: 'ignore' });
+    process.env.DISPLAY = '127.0.0.1:' + display;
+    await pause(500);
+  }
+  const electron = await _electron.launch({ executablePath: require('electron'), args: process.platform === 'linux' ? ['--no-sandbox', '--disable-gpu', root] : [root], env: { ...process.env, SCRATCH_TEST_MODE: '1', SCRATCH_TEST_DATA: path.join(work, 'data') }, timeout: 20000 });
+  const first = await electron.firstWindow();
+  await first.waitForSelector(`${active} .tiptap`, { timeout: 15000 });
+  await electron.evaluate(({ Menu, dialog }) => {
+    global.spellingMenus = [];
+    global.spellingDialogs = [];
+    global.spellingAnswers = [];
+    // Keep the real native menus and their handlers; only do not show them.
+    Menu.prototype.popup = function () { global.spellingMenus.push(this); };
+    // Message boxes are answered from spellingAnswers (Cancel when it is empty).
+    dialog.showMessageBox = async (_window, options) => { global.spellingDialogs.push({ ...options, icon: undefined }); return { response: global.spellingAnswers.length ? global.spellingAnswers.shift() : (options.cancelId ?? 1) }; };
+  });
+
+  const app = { electron, work, errors: [], page: null, win: null };
+
+  app.stop = async () => {
+    try { await electron.evaluate(({ app }) => app.exit()); } catch {}
+    virtualDisplay?.kill();
+  };
+
+  // Write a Markdown file into the work folder.
+  app.write = async (fileName, content) => {
+    const file = path.join(work, fileName);
+    await fs.writeFile(file, content);
+    return file;
+  };
+
+  // Make a document window the one the helpers work on.
+  app.use = async page => {
+    app.page = page;
+    app.win = await electron.browserWindow(page);
+    await app.win.evaluate(window => window.focus());
+    // Finds whole words in the formatted view, block by block: the wrapper of
+    // an ignored word splits it into two text nodes, so words are looked for
+    // in each block's whole text.
+    await page.evaluate(active => {
+      window.findWords = words => {
+        const root = document.querySelector(`${active} .tiptap`);
+        const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
+        const blocks = new Map();
+        for (let node; (node = walker.nextNode());) {
+          const block = node.parentElement.closest('p, h1, h2, h3, h4, h5, h6, pre, li, td, th') || root;
+          if (!blocks.has(block)) blocks.set(block, { text: '', parts: [] });
+          const entry = blocks.get(block);
+          entry.parts.push({ node, start: entry.text.length });
+          entry.text += node.data;
+        }
+        const out = [];
+        for (const { text, parts } of blocks.values()) {
+          const at = offset => { for (let i = parts.length - 1; i >= 0; i--) if (parts[i].start <= offset) return { node: parts[i].node, offset: offset - parts[i].start }; };
+          const re = /[\p{L}\p{N}]+(?:['’][\p{L}\p{N}]+)*/gu;
+          for (let m = re.exec(text); m; m = re.exec(text)) {
+            if (!words.includes(m[0])) continue;
+            const from = at(m.index), to = at(m.index + m[0].length - 1);
+            const range = document.createRange();
+            range.setStart(from.node, from.offset); range.setEnd(to.node, to.offset + 1);
+            out.push({ word: m[0], range, wrapped: !!from.node.parentElement.closest('[data-ignored-spelling]') });
+          }
+        }
+        return out;
+      };
+    }, active);
+  };
+
+  // Open a file the way Windows does when a .md file is double-clicked.
+  app.open = async file => {
+    const opened = electron.waitForEvent('window', { timeout: 15000 });
+    await electron.evaluate(({ app }, { file, dir }) => app.emit('second-instance', {}, [process.execPath, file], dir), { file, dir: path.dirname(file) });
+    const page = await opened;
+    page.on('pageerror', error => app.errors.push(String(error)));
+    await page.waitForSelector(`${active} .tiptap p`, { timeout: 15000 });
+    const win = await electron.browserWindow(page);
+    await win.evaluate(window => window.setBounds({ x: 0, y: 0, width: 1300, height: 1700 }));
+    await app.use(page);
+    await pause(500);
+    return page;
+  };
+
+  // Every whole-word occurrence of the listed words, in document order: 'red'
+  // (spelling underline), 'ignored' (no underline, first letter in an
+  // ignored-word wrapper) or 'plain' (no underline).
+  app.marks = async words => {
+    const rects = await app.page.evaluate(words => window.findWords(words).map(({ word, range, wrapped }) => {
+      const r = range.getBoundingClientRect();
+      return { word, x: r.x, y: r.y, w: r.width, h: r.height, wrapped, onScreen: r.top >= 0 && r.bottom + 4 <= innerHeight };
+    }), words);
+    return app.win.evaluate(async (window, rects) => {
+      const image = await window.webContents.capturePage();
+      const { width, height } = image.getSize();
+      const bitmap = image.toBitmap(); // BGRA
+      const isRed = i => bitmap[i + 2] > 170 && bitmap[i + 1] < 100 && bitmap[i] < 100;
+      return rects.map(r => {
+        if (!r.onScreen) return { word: r.word, state: 'off-screen' };
+        let count = 0;
+        for (let y = Math.max(0, Math.floor(r.y)); y < Math.min(height, Math.ceil(r.y + r.h + 4)); y++)
+          for (let x = Math.max(0, Math.floor(r.x) - 1); x < Math.min(width, Math.ceil(r.x + r.w) + 1); x++)
+            if (isRed((y * width + x) * 4)) count++;
+        return { word: r.word, state: count > 4 ? 'red' : r.wrapped ? 'ignored' : 'plain' };
+      });
+    }, rects);
+  };
+  app.byWord = list => { const out = {}; for (const mark of list) (out[mark.word] ||= []).push(mark.state); return out; };
+  app.describe = list => Object.entries(app.byWord(list)).map(([word, states]) => `${word}: ${states.join(' ')}`).join(' | ');
+
+  // Where the selection is, for failure messages: Chromium's background
+  // checks stop while its focus is inside a wrapper.
+  app.selectionState = () => app.page.evaluate(active => {
+    const selection = document.getSelection();
+    const show = (node, offset) => node ? `${node.nodeType === 3 ? JSON.stringify(node.data.slice(0, 16)) : `<${node.nodeName.toLowerCase()}>`}@${offset}${(node.nodeType === 1 ? node : node.parentElement)?.closest('[data-ignored-spelling]') ? ' (in wrapper)' : ''}` : 'none';
+    const editor = document.querySelector(`${active} .tiptap`).editor;
+    return { anchor: show(selection.anchorNode, selection.anchorOffset), focus: show(selection.focusNode, selection.focusOffset), editor: `${editor.state.selection.anchor}-${editor.state.selection.head}`, focused: document.hasFocus() };
+  }, active);
+
+  // Wait until the words are in the expected states, e.g.
+  // { Qarth: 'ignored', peeple: 'red' } (every occurrence in that state) or
+  // { Qarth: ['ignored', 'red'] }. Returns the time it took.
+  app.expectMarks = async (expected, step, timeout = 6000) => {
+    const words = Object.keys(expected);
+    const start = Date.now();
+    for (;;) {
+      const last = await app.marks(words);
+      const found = app.byWord(last);
+      if (words.every(word => {
+        const states = found[word] || [];
+        const want = expected[word];
+        return states.length > 0 && (Array.isArray(want) ? states.length === want.length && states.every((state, i) => state === want[i]) : states.every(state => state === want));
+      })) return Date.now() - start;
+      if (Date.now() - start > timeout) assert.fail(`${step}: expected ${JSON.stringify(expected)}, found ${app.describe(last)}; selection ${JSON.stringify(await app.selectionState())}`);
+      await pause(150);
+    }
+  };
+
+  // Sample the words' states while something happens and for a while after.
+  app.watch = async (words, during, { duration = 2500 } = {}) => {
+    const samples = [];
+    let running = true;
+    const sampler = (async () => { while (running) { samples.push(app.byWord(await app.marks(words))); await pause(60); } })();
+    await during();
+    await pause(duration);
+    running = false;
+    await sampler;
+    return samples;
+  };
+
+  app.pointOf = async (word, nth = 0) => {
+    const point = await app.page.evaluate(({ word, nth }) => {
+      const found = window.findWords([word])[nth];
+      if (!found) return null;
+      const r = found.range.getBoundingClientRect();
+      return { x: r.left + r.width / 2, y: r.top + r.height / 2 };
+    }, { word, nth });
+    assert(point, `"${word}" (occurrence ${nth + 1}) is not in the document`);
+    return point;
+  };
+
+  // Right-click a word; the native menu is captured instead of shown.
+  // Returns its labels ('-' for a separator).
+  app.rightClick = async (word, nth = 0) => {
+    const point = await app.pointOf(word, nth);
+    await electron.evaluate(() => { global.spellingMenus.length = 0; });
+    await app.page.mouse.click(point.x, point.y, { button: 'right' });
+    const start = Date.now();
+    while (!await electron.evaluate(() => global.spellingMenus.length)) {
+      if (Date.now() - start > 5000) assert.fail(`no right-click menu for "${word}"`);
+      await pause(50);
+    }
+    return electron.evaluate(() => global.spellingMenus[0].items.map(item => item.type === 'separator' ? '-' : item.label));
+  };
+  app.choose = label => electron.evaluate((_electron, label) => { global.spellingMenus[0].items.find(item => item.label === label).click(); }, label);
+
+  // Send a menu command to the current window.
+  app.command = (action, extra = {}) => app.win.evaluate((window, command) => window.webContents.send('scratch:command', command), { action, ...extra });
+  app.markdown = () => app.page.evaluate(active => document.querySelector(`${active} .tiptap`).editor.getMarkdown(), active);
+  app.dictionaryWords = () => electron.evaluate(({ session }) => session.defaultSession.listWordsInSpellCheckerDictionary());
+  // Answer the next message box (0 is its first button) and read what was shown.
+  app.answer = response => electron.evaluate((_electron, response) => { global.spellingAnswers.push(response); }, response);
+  app.dialogs = () => electron.evaluate(() => global.spellingDialogs.splice(0));
+
+  return app;
+}
+
+module.exports = { startSpellingApp, active, pause, root };
