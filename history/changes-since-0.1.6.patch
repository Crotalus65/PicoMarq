@@ -0,0 +1,161 @@
+import { findChildren } from "@tiptap/core";
+import type { Node as ProseMirrorNode } from "@tiptap/pm/model";
+import { Plugin, PluginKey, type EditorState, type Transaction } from "@tiptap/pm/state";
+import { Decoration, DecorationSet } from "@tiptap/pm/view";
+import highlight from "highlight.js/lib/core";
+
+/**
+ * Incremental replacement for the plugin in @tiptap/extension-code-block-lowlight.
+ *
+ * The stock plugin scans the whole document twice on every transaction
+ * (including plain cursor moves) to find code blocks, and re-highlights every
+ * code block in the document whenever one of them is edited. This version
+ * produces the same decorations but only touches blocks that actually
+ * changed, so typing cost no longer grows with document size.
+ */
+
+interface HighlightNode {
+  type?: string;
+  value?: string;
+  properties?: { className?: string[] };
+  children?: HighlightNode[];
+}
+
+interface LowlightLike {
+  highlight: (language: string, value: string) => { value?: HighlightNode[]; children?: HighlightNode[] };
+  highlightAuto: (value: string) => { value?: HighlightNode[]; children?: HighlightNode[] };
+  listLanguages: () => string[];
+  registered?: (aliasOrLanguage: string) => boolean;
+}
+
+export interface IncrementalLowlightOptions {
+  name: string;
+  lowlight: LowlightLike;
+  defaultLanguage: string | null | undefined;
+}
+
+// The next three helpers mirror the ones in @tiptap/extension-code-block-lowlight
+// so the generated class names are identical.
+function parseNodes(nodes: HighlightNode[], className: string[] = []): { text: string; classes: string[] }[] {
+  return nodes.flatMap((node) => {
+    const classes = [...className, ...(node.properties ? node.properties.className ?? [] : [])];
+    if (node.children) return parseNodes(node.children, classes);
+    return { text: node.value ?? "", classes };
+  });
+}
+
+function getHighlightNodes(result: { value?: HighlightNode[]; children?: HighlightNode[] }): HighlightNode[] {
+  return result.value || result.children || [];
+}
+
+function registered(aliasOrLanguage: string): boolean {
+  return Boolean(highlight.getLanguage(aliasOrLanguage));
+}
+
+function blockDecorations(
+  block: ProseMirrorNode,
+  pos: number,
+  { lowlight, defaultLanguage }: IncrementalLowlightOptions,
+): Decoration[] {
+  const decorations: Decoration[] = [];
+  let from = pos + 1;
+  const language = block.attrs.language || defaultLanguage;
+  const languages = lowlight.listLanguages();
+  const nodes =
+    language && (languages.includes(language) || registered(language) || lowlight.registered?.(language))
+      ? getHighlightNodes(lowlight.highlight(language, block.textContent))
+      : getHighlightNodes(lowlight.highlightAuto(block.textContent));
+  parseNodes(nodes).forEach((node) => {
+    const to = from + node.text.length;
+    if (node.classes.length) {
+      decorations.push(Decoration.inline(from, to, { class: node.classes.join(" ") }));
+    }
+    from = to;
+  });
+  return decorations;
+}
+
+function allDecorations(doc: ProseMirrorNode, options: IncrementalLowlightOptions): DecorationSet {
+  const decorations: Decoration[] = [];
+  findChildren(doc, (node) => node.type.name === options.name).forEach((block) => {
+    decorations.push(...blockDecorations(block.node, block.pos, options));
+  });
+  return DecorationSet.create(doc, decorations);
+}
+
+/**
+ * Call `f` for every node in `cur` that is not identical (same object) to
+ * the corresponding node in `old`. Parents are reported before children.
+ * ProseMirror nodes are immutable and shared across versions, so unchanged
+ * subtrees are skipped in O(1).
+ */
+function changedDescendants(
+  old: ProseMirrorNode,
+  cur: ProseMirrorNode,
+  offset: number,
+  f: (node: ProseMirrorNode, pos: number) => void,
+): void {
+  const oldSize = old.childCount;
+  const curSize = cur.childCount;
+  outer: for (let i = 0, j = 0; i < curSize; i++) {
+    const child = cur.child(i);
+    for (let scan = j, e = Math.min(oldSize, i + 3); scan < e; scan++) {
+      if (old.child(scan) === child) {
+        j = scan + 1;
+        offset += child.nodeSize;
+        continue outer;
+      }
+    }
+    f(child, offset);
+    if (j < oldSize && old.child(j).sameMarkup(child)) {
+      changedDescendants(old.child(j), child, offset + 1, f);
+    } else {
+      child.nodesBetween(0, child.content.size, f, offset + 1);
+    }
+    offset += child.nodeSize;
+  }
+}
+
+export const incrementalLowlightKey = new PluginKey<DecorationSet>("lowlight");
+
+export function IncrementalLowlightPlugin(options: IncrementalLowlightOptions): Plugin<DecorationSet> {
+  const { lowlight } = options;
+  if (!["highlight", "highlightAuto", "listLanguages"].every((api) => typeof (lowlight as unknown as Record<string, unknown>)[api] === "function")) {
+    throw Error("You should provide an instance of lowlight to use the code-block-lowlight extension");
+  }
+  const plugin: Plugin<DecorationSet> = new Plugin<DecorationSet>({
+    key: incrementalLowlightKey,
+    state: {
+      init: (_, { doc }) => allDecorations(doc, options),
+      apply: (transaction: Transaction, decorationSet: DecorationSet, oldState: EditorState, newState: EditorState) => {
+        if (!transaction.docChanged) return decorationSet;
+        let set = decorationSet.map(transaction.mapping, transaction.doc);
+        changedDescendants(oldState.doc, newState.doc, 0, (node, pos) => {
+          // Highlight decorations only ever live inside textblocks, and an
+          // unchanged code block nested in a changed container keeps its
+          // identity (and its mapped decorations), so containers are skipped.
+          if (!node.isTextblock) return;
+          const end = pos + node.nodeSize;
+          // Drop every mapped decoration touching a changed textblock: a code
+          // block may have been edited or turned into a paragraph, and a
+          // decoration mapped across a split now straddles two blocks. Fresh
+          // decorations never cross block boundaries, so anything overlapping
+          // the block is stale. Then highlight it afresh when it is a code block.
+          const stale = set.find(pos, end);
+          if (stale.length) set = set.remove(stale);
+          if (node.type.name === options.name) {
+            const fresh = blockDecorations(node, pos, options);
+            if (fresh.length) set = set.add(transaction.doc, fresh);
+          }
+        });
+        return set;
+      },
+    },
+    props: {
+      decorations(state) {
+        return plugin.getState(state);
+      },
+    },
+  });
+  return plugin;
+}
diff --git a/src/components/editor/markdown-serialize.ts b/src/components/editor/markdown-serialize.ts
new file mode 100644
index 0000000..2c9a775
--- /dev/null
+++ b/src/components/editor/markdown-serialize.ts
@@ -0,0 +1,122 @@
+import type { JSONContent } from "@tiptap/core";
+import type { Node as ProseMirrorNode } from "@tiptap/pm/model";
+import { escapeMarkdownText } from "../../lib/markdown-escape";
+
+/** The part of TipTap's MarkdownManager this module relies on. */
+export interface MarkdownRenderer {
+  renderNodeToMarkdown: (node: JSONContent, parentNode?: JSONContent, index?: number, level?: number) => string;
+}
+
+// Markdown of each top-level block, keyed by the immutable ProseMirror node.
+// After an edit only the blocks on the path to the change are new objects, so
+// the rest of the document is reused instead of being re-serialized.
+const blockMarkdown = new WeakMap<ProseMirrorNode, string>();
+
+// Mirrors MarkdownManager.isEmptyOutput: output made only of whitespace and
+// the "&nbsp;" placeholders empty paragraphs render to counts as empty.
+const EMPTY_OUTPUT = /^(?:\s|&nbsp;)*$/;
+
+/**
+ * The inline content of a text block as JSON, with prose escaped so that the
+ * Markdown reads back as the same text. Code spans are left alone, like code
+ * blocks. Tracks where each text node sits: at the start of an output line
+ * (where "# " or "1. " would become a heading or list), in a table cell
+ * (where "|" would end the cell), or at the end of a heading (where a
+ * trailing "#" would be dropped).
+ */
+function escapedInlineContent(block: ProseMirrorNode, inTableCell: boolean): JSONContent[] {
+  // Adjacent text nodes with the same marks render as one run of text, and a
+  // parsed document holds many of them ("$", "$" for an escaped "$$"), so
+  // they are joined first: escaping looks at neighbouring characters.
+  const children: ProseMirrorNode[] = [];
+  block.forEach((child) => {
+    const previous = children[children.length - 1];
+    if (previous && previous.isText && child.isText && previous.sameMarkup(child)) {
+      children[children.length - 1] = block.type.schema.text((previous.text ?? "") + (child.text ?? ""), previous.marks);
+    } else {
+      children.push(child);
+    }
+  });
+  // Nothing can start a block inside a heading or a table cell, so
+  // "# 1. Introduction" and "| 1. x |" are written as they are.
+  const heading = block.type.name === "heading";
+  const blocksCanStart = !heading && !inTableCell;
+  const content: JSONContent[] = [];
+  const last = children.length - 1;
+  let lineStart = blocksCanStart;
+  children.forEach((child, index) => {
+    const json = child.toJSON() as JSONContent;
+    if (child.isText && child.text) {
+      if (child.marks.some((mark) => mark.type.spec.code)) {
+        lineStart = false;
+      } else {
+        json.text = escapeMarkdownText(child.text, {
+          lineStart,
+          inTableCell,
+          headingEnd: heading && index === last && child.marks.length === 0,
+        });
+        lineStart = blocksCanStart && child.text.endsWith("\n");
+      }
+    } else {
+      lineStart = blocksCanStart && child.type.name === "hardBreak";
+    }
+    content.push(json);
+  });
+  return content;
+}
+
+/**
+ * What `node.toJSON()` returns, except that prose is escaped for Markdown
+ * output. Nodes whose content is code (code blocks, front matter) are copied
+ * as they are.
+ */
+export function escapedJSON(node: ProseMirrorNode, inTableCell = false): JSONContent {
+  const json: JSONContent = { type: node.type.name };
+  for (const _ in node.attrs) { json.attrs = node.attrs; break; }
+  if (node.marks.length) json.marks = node.marks.map((mark) => mark.toJSON());
+  if (node.isText) {
+    json.text = node.text;
+    return json;
+  }
+  if (!node.content.size) return json;
+  if (node.type.spec.code) {
+    json.content = node.content.toJSON() as JSONContent[];
+    return json;
+  }
+  const role = node.type.spec.tableRole;
+  const cell = inTableCell || role === "cell" || role === "header_cell";
+  if (node.isTextblock) {
+    json.content = escapedInlineContent(node, cell);
+  } else {
+    const content: JSONContent[] = [];
+    node.forEach((child) => content.push(escapedJSON(child, cell)));
+    json.content = content;
+  }
+  return json;
+}
+
+/**
+ * Serialize a document to Markdown with the same result as
+ * `manager.serialize(escapedJSON(doc))`, re-rendering only changed blocks.
+ *
+ * The document renderer joins its children with a blank line and no block
+ * renderer depends on its position among siblings, so each block can be
+ * rendered on its own exactly as the full serializer would render it.
+ */
+export function serializeDocumentMarkdown(manager: MarkdownRenderer, doc: ProseMirrorNode): string {
+  // What Node.toJSON() would produce for the parent, minus the content the
+  // renderers never read.
+  const parent: JSONContent = { type: doc.type.name };
+  for (const _ in doc.attrs) { parent.attrs = doc.attrs; break; }
+  const parts: string[] = [];
+  doc.forEach((block, _offset, index) => {
+    let markdown = blockMarkdown.get(block);
+    if (markdown === undefined) {
+      markdown = manager.renderNodeToMarkdown(escapedJSON(block), parent, index, 0);
+      blockMarkdown.set(block, markdown);
+    }
+    parts.push(markdown);
+  });
+  const result = parts.join("\n\n");
+  return EMPTY_OUTPUT.test(result) ? "" : result;
+}
